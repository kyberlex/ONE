assets/ebooks/logs/
assets/ebooks/logs/**
*.log

# System metadata
.DS_Store
*/.DS_Store
Thumbs.db

# Temporary translation caches and runtime temp files
*.tmp
*.bin
*.temp.bin
pipeline_status*.tmp

# Version control artifacts
.git/
.gitignore
.surgeignore
